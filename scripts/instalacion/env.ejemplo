# Copiar a .env.instalacion (en la raíz del repo; NO se sube a git).
#
# Cadenas de conexión: en Supabase → botón «Connect» → «Session pooler».
# (La conexión directa db.xxx.supabase.co:5432 puede no responder desde
# algunas redes.) Usuario: postgres.<id-del-proyecto>.

# ---------- Origen: la base de donde se copia la ESTRUCTURA ----------
ORIGEN_DB_URL='postgresql://postgres.<id>:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres'

# ---------- Destino: el proyecto nuevo (demo o cliente) ----------
DESTINO_DB_URL='postgresql://postgres.<id>:CONTRASEÑA@aws-0-<region>.pooler.supabase.com:5432/postgres'
# Project Settings → API (o «Connect»): URL y secret key (service_role).
DESTINO_SUPABASE_URL='https://<id>.supabase.co'
DESTINO_SECRET_KEY=''
# Dirección de la app en Vercel.
DESTINO_APP_URL='https://servitec-demo.vercel.app'
# Secreto de los avisos programados: openssl rand -hex 32
# El mismo valor va como CRON_SECRET en las variables de Vercel.
DESTINO_CRON_SECRET=''

# ---------- Solo para el demo ----------
# Contraseñas de las cuentas de acceso rápido (son públicas: van en el login).
DEMO_SUPERVISOR_CONTRASENA=''
DEMO_TECNICO_CONTRASENA=''

# Carpeta con pg_dump/psql 17 si no se usa scripts/instalacion/.pg17
PG_BIN=''
